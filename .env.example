# ---------------------------------------------------------------------------
# Legal AI Assistant - environment configuration
# Copy this file to `.env` and fill in the values you need.
# The app runs with ZERO configuration using MOCK mode if nothing is set.
# ---------------------------------------------------------------------------

# Which AI provider to use: "groq" | "anthropic" | "openai" | "mock"
# If left blank, the app auto-selects: groq -> anthropic -> openai -> mock (in that
# order, based on which API key is present).
AI_PROVIDER=mock

# Groq configuration (recommended — fast, free-tier-friendly)
# Get a key at https://console.groq.com/keys
# NOTE: llama-3.3-70b-versatile / llama-3.1-8b-instant now require an
# Enterprise Groq plan. openai/gpt-oss-20b and openai/gpt-oss-120b are the
# models available on a standard developer key as of late 2026 — check
# https://console.groq.com/docs/models for the current list if this changes.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic (Claude) configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application settings
MAX_UPLOAD_CHARS=200000
CHUNK_SIZE_CHARS=3000
CHUNK_OVERLAP_CHARS=200
LOG_LEVEL=INFO
